{
  "extends": "stylelint-config-standard",
  "rules": {
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "theme",
          "utility",
          "variant",
          "custom-variant",
          "apply",
          "source",
          "plugin"
        ]
      }
    ],
    "import-notation": null,
    "custom-property-empty-line-before": null,
    "custom-property-pattern": [
      "^[a-z][a-z0-9]*(-[a-z0-9]+)*(--[a-z0-9]+(-[a-z0-9]+)*)?$",
      {
        "message": "Expected kebab-case, optionally with a Tailwind modifier suffix (--line-height)"
      }
    ]
  }
}

{
  "name": "mystic-falls-codex",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "biome check . && eslint . && stylelint \"src/**/*.css\" && tsc --noEmit",
    "check:fix": "biome check --write . && eslint . --fix && stylelint \"src/**/*.css\" --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10",
    "eslint-config-next": "16.3.4",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
